# ---- Build output -------------------------------------------------------
# CMake generates thousands of files here. None of them are source, all of
# them are reproducible from the source, so none of them belong in history.
build/
cmake-build-*/
out/

# CMake droppings if anyone ever configures in-source (don't, but just in case)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# ---- Compiled artefacts -------------------------------------------------
*.exe
*.out
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib
des

# ---- MSVC / Visual Studio ----------------------------------------------
*.pdb
*.ilk
*.idb
*.sln
*.vcxproj
*.vcxproj.*
*.tlog
.vs/
x64/
Debug/
Release/

# ---- Editors & OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ---- v2 output ----------------------------------------------------------
# Simulation traces and result dumps: regenerable, often large, and they make
# every diff unreadable. Ignore them from the start.
welch_series.csv
*.trace
results/

# ---- example artefacts --------------------------------------------------
examples/trace_*.md
examples/welch_*.csv
ex[0-9]*
libdes.a
obj/
trace_*.md
# docs/* rather than docs/ : git cannot re-include anything inside an EXCLUDED
# DIRECTORY, so `docs/` followed by `!docs/superpowers/` silently does nothing.
# Excluding the CONTENTS instead leaves the negation able to work.
docs/*
# The design record is part of the project, like the readlogs it continues.
# Specs and plans are versioned; anything else under docs/ is not.
!docs/superpowers/

*.txt
# The trace baselines are .txt and they ARE the byte-identical gate. Ignored,
# a newly captured baseline would be silently refused and the gate would cover
# fewer examples than it appears to -- a gate that stops being a gate without
# saying so.
!tests/baseline/*.txt
# Test artefacts written by the suite into the working directory
/trace_text.md
/trace_code.md
/out.txt
/err.txt
/asan_out.txt

# Python bytecode from tools/
__pycache__/
/doc_trace.md
/cpp_trace.md
/step_whole.md
/step_1.md
/step_7.md
/step_1000.md
