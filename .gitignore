# ---- Build output -------------------------------------------------------
# CMake generates thousands of files here. None of them are source, all of
# them are reproducible from the source, so none of them belong in history.
build/
cmake-build-*/
out/

# CMake droppings if anyone ever configures in-source (don't, but just in case)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# ---- Compiled artefacts -------------------------------------------------
*.exe
*.out
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib
des

# ---- MSVC / Visual Studio ----------------------------------------------
*.pdb
*.ilk
*.idb
*.sln
*.vcxproj
*.vcxproj.*
*.tlog
.vs/
x64/
Debug/
Release/

# ---- Editors & OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ---- v2 output ----------------------------------------------------------
# Simulation traces and result dumps: regenerable, often large, and they make
# every diff unreadable. Ignore them from the start.
welch_series.csv
*.trace
results/

# ---- example artefacts --------------------------------------------------
examples/trace_*.md
examples/welch_*.csv
ex[0-9]*
libdes.a
obj/
trace_*.md
docs/
*.txt
# Test artefacts written by the suite into the working directory
/trace_text.md
/trace_code.md
/out.txt
/err.txt
/asan_out.txt
