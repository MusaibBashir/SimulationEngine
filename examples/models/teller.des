version = 1

# How to run it. Arena keeps this in Run Setup; here it is a module like any
# other, so the file says everything needed to reproduce a result.
[Run]
Name         = Setup
Length       = 480
Replications = 1

# A single teller. The smallest model the format can express.
[Create]
Name         = Arrivals
Interarrival = EXPO(1.0)
Next         = Serve

[Process]
Name       = Serve
Capacity   = 1
Discipline = FIFO
Service    = EXPO(0.8)
Next       = Out

[Dispose]
Name = Out
